# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Para descobrir seu username: publique qualquer prompt no LangSmith Hub, depois abra-o e clique no ícone de cadeado (🔒) para ver seu username.
USERNAME_LANGSMITH_HUB=

# OpenAI Configuration
OPENAI_API_KEY=

# Google Gemini Configuration
GOOGLE_API_KEY=

# LLM Configuration
# Atenção: nomes/versões de modelos mudam com frequência. Se receber erro 404 (modelo
# descontinuado) ou 429 (cota diária excedida no free tier), consulte a documentação
# oficial do provedor escolhido e ajuste os valores abaixo.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.6-flash
EVAL_MODEL=gemini-3.6-flash

#LLM_PROVIDER=openai
#LLM_MODEL=gpt-4o-mini
#EVAL_MODEL=gpt-4o